{
  "name": "metricground",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "sync:duckdb": "node scripts/sync-duckdb-assets.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --port 5173 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/duckdb --ignore-pattern runtime",
    "typecheck": "tsc --noEmit",
    "test:core": "node --experimental-strip-types scripts/verify-core-boundaries.mjs",
    "test:profile": "npm run test:browser:reset && node scripts/verify-file-profile.mjs ../evaluation/fixtures/excel_multi_sheet_sample.xlsx",
    "test:quality": "npm run test:browser:reset && node scripts/verify-quality-checks.mjs",
    "test:quality-impact": "node --experimental-strip-types scripts/verify-quality-impact.mjs",
    "test:cleaning": "npm run test:browser:reset && node scripts/verify-cleaning-workflow.mjs",
    "test:metric": "npm run test:browser:reset && node scripts/verify-metric-contract.mjs",
    "test:execution": "npm run test:browser:reset && node scripts/verify-controlled-execution.mjs",
    "test:analysis": "node --experimental-strip-types scripts/verify-business-analysis-core.mjs",
    "test:analysis:e2e": "npm run test:browser:reset && node scripts/verify-business-analysis.mjs",
    "test:agent": "npm run test:browser:reset && node scripts/verify-agent-orchestration.mjs",
    "test:agent:foundation": "node --experimental-strip-types scripts/verify-agent-foundation.mjs",
    "test:catalog": "node --experimental-strip-types scripts/verify-dataset-catalog.mjs",
    "test:join": "node --experimental-strip-types scripts/verify-controlled-join.mjs",
    "test:agent:runtime": "node --experimental-strip-types scripts/verify-agent-runtime.mjs",
    "test:evidence": "node --experimental-strip-types scripts/verify-evidence-package.mjs",
    "test:scenarios": "node --experimental-strip-types scripts/evaluate-cross-scenarios.mjs",
    "test:providers": "node --experimental-strip-types scripts/verify-model-providers.mjs",
    "test:join:e2e": "npm run test:browser:reset && node scripts/verify-multi-table-ui.mjs",
    "test:join:reconciliation": "npm run test:browser:reset && node scripts/verify-join-reconciliation-ui.mjs",
    "test:join:three-table": "npm run test:browser:reset && node scripts/verify-three-table-wizard.mjs",
    "test:guide:e2e": "npm run test:browser:reset && node scripts/verify-novice-guide.mjs",
    "test:novice-files": "npm run test:browser:reset && node scripts/verify-novice-test-files.mjs",
    "test:persistence": "node scripts/verify-task-persistence.mjs",
    "test:upload-boundaries": "node --experimental-strip-types scripts/verify-upload-boundaries.mjs",
    "test:recovery": "node scripts/verify-workspace-recovery.mjs",
    "test:d1:recovery": "node scripts/verify-d1-recovery.mjs",
    "test:browser:reset": "node scripts/reset-browser-workspace.mjs",
    "test:workbench": "npm run test:browser:reset && node scripts/evaluate-workbench.mjs",
    "test:ci:static": "npm run lint && npm run typecheck && npm run build && npm run test:core && npm run test:upload-boundaries && npm run test:quality-impact && npm run test:analysis && npm run test:agent:foundation && npm run test:catalog && npm run test:join && npm run test:agent:runtime && npm run test:evidence && npm run test:providers",
    "test:ci:browser": "npm run test:scenarios && npm run test:agent && npm run test:profile && npm run test:quality && npm run test:cleaning && npm run test:metric && npm run test:execution && npm run test:workbench && npm run test:release:browser && npm run test:recovery && npm run test:persistence && npm run test:d1:recovery",
    "test:release": "npm run lint && npm run typecheck && npm run build && npm run test:core && npm run test:profile && npm run test:quality && npm run test:quality-impact && npm run test:cleaning && npm run test:metric && npm run test:execution && npm run test:analysis && npm run test:agent:foundation && npm run test:catalog && npm run test:join && npm run test:agent:runtime && npm run test:evidence && npm run test:scenarios && npm run test:providers && npm run test:workbench",
    "test:release:browser": "npm run test:analysis:e2e && npm run test:guide:e2e && npm run test:join:e2e && npm run test:join:reconciliation && npm run test:join:three-table && npm run test:novice-files",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@base-ui/react": "^1.7.0",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "ai": "^7.0.99",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "read-excel-file": "^9.3.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
