# 默认路径：本地 Ollama，不需要付费 API。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# 托管平台必须先清除外部伪造头，再注入 oai-authenticated-user-id。
# 本地开发默认 false；公开部署建议在完成登录验收后设为 true。
METRICGROUND_REQUIRE_AUTH=false

# 可选云端降级。只有显式设为 true，且同时填写 API Key 与模型名时才启用。
# 浏览器只向模型发送字段画像、质量摘要和业务问题，不发送 Excel/CSV 原始数据行。
AGENT_CLOUD_FALLBACK=false

# Groq（可选；模型名不内置，避免免费模型下线后静默漂移）
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 阿里云百炼 DashScope OpenAI 兼容接口（可选）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DuckDB-WASM 默认从 @duckdb/duckdb-wasm 1.32.0 的官方 jsDelivr 路径加载，
# 避免超过 Cloudflare Workers 单静态资源 25 MiB 限制。
# 完全离线运行时先执行 npm run sync:duckdb，再启用下面一行。
# NEXT_PUBLIC_DUCKDB_ASSET_BASE_URL=/duckdb
