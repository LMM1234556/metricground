# 默认路径：本地 Ollama，不需要付费 API。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# 托管平台必须先清除外部伪造头，再注入 oai-authenticated-user-id。
# 本地开发默认 false；恢复账号访问时设为 true。
METRICGROUND_REQUIRE_AUTH=false
# 临时免登录测试必须设为 true，为每个浏览器签发独立匿名会话。
# 两者均为 false 只用于本地开发，不应部署到公开站点。
METRICGROUND_ANONYMOUS_SESSIONS=false

# 可选云端降级。只有显式设为 true，且同时填写 API Key 与模型名时才启用。
# 浏览器只向模型发送字段画像、质量摘要和业务问题，不发送 Excel/CSV 原始数据行。
AGENT_CLOUD_FALLBACK=false
# 可选 cloud-only 避免公网云模型前先尝试本机地址；false 开关仍优先，返回规则兜底。
AGENT_PROVIDER_MODE=local-first
# 试验版云端仅允许 dashscope/qwen-plus：累计20次HTTP请求，每问题2次，输出512 Token，输入24KB。
# 累计计数存D1，重启/换IP/换日期不会自动清零；这不是人民币金额上限。

# Groq（可选；模型名不内置，避免免费模型下线后静默漂移）
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 阿里云百炼 DashScope OpenAI 兼容接口（可选）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DuckDB-WASM 默认使用构建时生成的同源 /duckdb 压缩资源；下方变量仅用于覆盖资源路径。
# NEXT_PUBLIC_DUCKDB_ASSET_BASE_URL=/duckdb
